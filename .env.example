# Required by rdash.py
RDASH_BASE_URL=https://api.rdash.id/v1
RDASH_RESELLER_ID=
RDASH_API_KEY=

# Required by 10_create_customer.py
RDASH_CUSTOMER_NAME=
RDASH_CUSTOMER_EMAIL=
RDASH_CUSTOMER_PASSWORD=
RDASH_CUSTOMER_ORGANIZATION=
RDASH_CUSTOMER_STREET=
RDASH_CUSTOMER_CITY=
RDASH_CUSTOMER_STATE=
RDASH_CUSTOMER_POSTAL_CODE=
RDASH_CUSTOMER_PHONE=

# Optional. Defaults to ID. Also read by 34_update_customer.py via the password above.
RDASH_CUSTOMER_COUNTRY=ID
